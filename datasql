  <script src="/_sdk/editing_sdk.js"></script>
  <script>
    const brands = [
      {brand_id:1,brand_name:'Nike',country:'USA'},
      {brand_id:2,brand_name:'Adidas',country:'Germany'},
      {brand_id:3,brand_name:'New Balance',country:'USA'}
    ];
    const products = [
      {product_id:1,product_name:'Air Max 90',brand_id:1,category:'Sneakers',price:130.00,stock_qty:45},
      {product_id:2,product_name:'Ultraboost 22',brand_id:2,category:'Running',price:190.00,stock_qty:30},
      {product_id:3,product_name:'574 Classic',brand_id:3,category:'Sneakers',price:89.99,stock_qty:60},
      {product_id:4,product_name:'Dunk Low',brand_id:1,category:'Sneakers',price:110.00,stock_qty:25},
      {product_id:5,product_name:'Samba OG',brand_id:2,category:'Casual',price:100.00,stock_qty:55}
    ];
    const customers = [
      {customer_id:1,full_name:'Alex Rivera',email:'alex@mail.com',city:'Austin'},
      {customer_id:2,full_name:'Jordan Lee',email:'jordan@mail.com',city:'Dallas'},
      {customer_id:3,full_name:'Sam Chen',email:'sam@mail.com',city:'Houston'}
    ];
    const orders = [
      {order_id:1,customer_id:1,order_date:'2026-05-01',total_amount:240.00},
      {order_id:2,customer_id:2,order_date:'2026-05-03',total_amount:190.00},
      {order_id:3,customer_id:3,order_date:'2026-05-10',total_amount:199.99}
    ];
    const order_items = [
      {item_id:1,order_id:1,product_id:1,quantity:1,unit_price:130.00},
      {item_id:2,order_id:1,product_id:4,quantity:1,unit_price:110.00},
      {item_id:3,order_id:2,product_id:2,quantity:1,unit_price:190.00},
      {item_id:4,order_id:3,product_id:3,quantity:1,unit_price:89.99},
      {item_id:5,order_id:3,product_id:5,quantity:1,unit_price:110.00}
    ];

    const queries = [
      {
        label:'All Products',
        sql:`SELECT p.product_name, b.brand_name,
       p.category, p.price, p.stock_qty
FROM products p
JOIN brands b ON p.brand_id = b.brand_id
ORDER BY p.price DESC;`,
        run:()=>products.map(p=>{
          const b=brands.find(x=>x.brand_id===p.brand_id);
          return{product_name:p.product_name,brand_name:b.brand_name,category:p.category,price:'$'+p.price.toFixed(2),stock_qty:p.stock_qty};
        }).sort((a,b)=>parseFloat(b.price.slice(1))-parseFloat(a.price.slice(1)))
      },
      {
        label:'Revenue by Brand',
        sql:`SELECT b.brand_name,
       SUM(oi.quantity * oi.unit_price) AS total_revenue
FROM order_items oi
JOIN products p ON oi.product_id = p.product_id
JOIN brands b ON p.brand_id = b.brand_id
GROUP BY b.brand_name
ORDER BY total_revenue DESC;`,
        run:()=>{
          const rev={};
          order_items.forEach(oi=>{
            const p=products.find(x=>x.product_id===oi.product_id);
            const b=brands.find(x=>x.brand_id===p.brand_id);
            rev[b.brand_name]=(rev[b.brand_name]||0)+oi.quantity*oi.unit_price;
          });
          return Object.entries(rev).sort((a,b)=>b[1]-a[1]).map(([n,v])=>({brand_name:n,total_revenue:'$'+v.toFixed(2)}));
        }
      },
      {
        label:'Customer Orders',
        sql:`SELECT c.full_name, c.city,
       o.order_date, o.total_amount
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id
ORDER BY o.order_date;`,
        run:()=>orders.map(o=>{
          const c=customers.find(x=>x.customer_id===o.customer_id);
          return{full_name:c.full_name,city:c.city,order_date:o.order_date,total_amount:'$'+o.total_amount.toFixed(2)};
        })
      },
      {
        label:'Low Stock Alert',
        sql:`SELECT product_name, stock_qty
FROM products
WHERE stock_qty < 40
ORDER BY stock_qty ASC;`,
        run:()=>products.filter(p=>p.stock_qty<40).sort((a,b)=>a.stock_qty-b.stock_qty).map(p=>({product_name:p.product_name,stock_qty:p.stock_qty}))
      },
      {
        label:'Top Selling Items',
        sql:`SELECT p.product_name,
       SUM(oi.quantity) AS units_sold,
       SUM(oi.quantity * oi.unit_price) AS revenue
FROM order_items oi
JOIN products p ON oi.product_id = p.product_id
GROUP BY p.product_name
ORDER BY units_sold DESC;`,
        run:()=>{
          const m={};
          order_items.forEach(oi=>{
            const p=products.find(x=>x.product_id===oi.product_id);
            if(!m[p.product_name])m[p.product_name]={units:0,rev:0};
            m[p.product_name].units+=oi.quantity;
            m[p.product_name].rev+=oi.quantity*oi.unit_price;
          });
          return Object.entries(m).sort((a,b)=>b[1].units-a[1].units).map(([n,v])=>({product_name:n,units_sold:v.units,revenue:'$'+v.rev.toFixed(2)}));
        }
      }
    ];

    let activeQuery=0;
    const btnContainer=document.getElementById('query-buttons');
    const display=document.getElementById('query-display');

    function highlight(sql){
      return sql
        .replace(/\b(SELECT|FROM|JOIN|ON|WHERE|ORDER BY|GROUP BY|SUM|COUNT|AS|DESC|ASC|AND|OR|NOT NULL|INSERT INTO|VALUES|CREATE TABLE|PRIMARY KEY|REFERENCES|DEFAULT|UNIQUE|INT|VARCHAR|DECIMAL|DATE)\b/gi,m=>{
          const u=m.toUpperCase();
          if(['INT','VARCHAR','DECIMAL','DATE'].includes(u))return`<span class="typ">${m}</span>`;
          if(['SUM','COUNT'].includes(u))return`<span class="fn">${m}</span>`;
          return`<span class="kw">${m}</span>`;
        })
        .replace(/'[^']*'/g,m=>`<span class="str">${m}</span>`)
        .replace(/\b\d+(\.\d+)?\b/g,m=>`<span class="num">${m}</span>`);
    }

    queries.forEach((q,i)=>{
      const btn=document.createElement('button');
      btn.className='query-btn px-3 py-1.5 rounded-md text-sm border border-[#21262d] text-[#c9d1d9]'+(i===0?' active':'');
      btn.textContent=q.label;
      btn.onclick=()=>selectQuery(i);
      btnContainer.appendChild(btn);
    });

    function selectQuery(i){
      activeQuery=i;
      btnContainer.querySelectorAll('.query-btn').forEach((b,j)=>b.classList.toggle('active',j===i));
      display.innerHTML=highlight(queries[i].sql);
      document.getElementById('results-section').classList.add('hidden');
    }

    function runQuery(){
      const data=queries[activeQuery].run();
      const section=document.getElementById('results-section');
      const table=document.getElementById('results-table');
      if(!data.length){table.innerHTML='<tr><td class="p-4 text-center opacity-50">No results</td></tr>';section.classList.remove('hidden');return;}
      const keys=Object.keys(data[0]);
      table.innerHTML='<thead><tr>'+keys.map(k=>`<th class="px-4 py-2 text-left text-xs uppercase tracking-wider text-[#8b949e]">${k}</th>`).join('')+'</tr></thead><tbody>'+
        data.map(r=>'<tr class="hover:bg-[#161b22] transition-colors">'+keys.map(k=>`<td class="px-4 py-2 text-[#c9d1d9]">${r[k]}</td>`).join('')+'</tr>').join('')+'</tbody>';
      section.classList.remove('hidden');
      section.classList.remove('fade-in');
      void section.offsetWidth;
      section.classList.add('fade-in');
    }

    selectQuery(0);
    lucide.createIcons();
  </script>
