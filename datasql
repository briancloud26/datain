"str">'sam@mail.com'</span>, <span class="str">'Houston'</span>); <span class="kw">INSERT INTO</span> <span class="tbl">orders</span> <span class="kw">VALUES</span> (<span class="num">1</span>, <span class="num">1</span>, <span class="str">'2026-05-01'</span>, <span class="num">240.00</span>), (<span class="num">2</span>, <span class="num">2</span>, <span class="str">'2026-05-03'</span>, <span class="num">190.00</span>), (<span class="num">3</span>, <span class="num">3</span>, <span class="str">'2026-05-10'</span>, <span class="num">199.99</span>); <span class="kw">INSERT INTO</span> <span class="tbl">order_items</span> <span class="kw">VALUES</span> (<span class="num">1</span>, <span class="num">1</span>, <span class="num">1</span>, <span class="num">1</span>, <span class="num">130.00</span>), (<span class="num">2</span>, <span class="num">1</span>, <span class="num">4</span>, <span class="num">1</span>, <span class="num">110.00</span>), (<span class="num">3</span>, <span class="num">2</span>, <span class="num">2</span>, <span class="num">1</span>, <span class="num">190.00</span>), (<span class="num">4</span>, <span class="num">3</span>, <span class="num">3</span>, <span class="num">1</span>, <span class="num">89.99</span>), (<span class="num">5</span>, <span class="num">3</span>, <span class="num">5</span>, <span class="num">1</span>, <span class="num">110.00</span>);
    </div>
