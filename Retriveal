     <div class="flex items-center gap-4">
      <div data-template-id="brand-mark" class="canva-container w-11 h-11 rounded-2xl flex items-center justify-center text-white font-bold brand-serif text-lg" style="background: rgb(23, 50, 45); color: rgb(255, 255, 255); font-weight: 700;">
       W
      </div>
      <div>
       <h1 data-template-id="page-title" class="canva-text brand-serif leading-tight" style="color: rgb(23, 50, 45); font-weight: 700; font-style: normal; font-size: 30px;">Workfold</h1>
       <p data-template-id="page-subtitle" class="canva-text mt-1" style="color: rgb(113, 129, 124); font-weight: 400; font-style: normal; font-size: 14px;">Employee work tracker</p>
      </div>
     </div><button id="openFormBtn" data-template-id="open-form-button" class="canva-button focus-ring hidden sm:inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition hover:opacity-90" style="background: rgb(23, 50, 45); color: rgb(255, 255, 255); font-weight: 600; font-style: normal; font-size: 15px;">Add new task</button>
    </div>
   </header>
   <main class="max-w-7xl mx-auto px-5 md:px-8 py-7 md:py-10">
    <section class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
     <article data-template-id="stat-card-total" class="canva-card rounded-[24px] p-5 border border-[#dde7df] card-shadow" style="background: rgb(255, 253, 248);">
      <div class="flex items-start justify-between">
       <div>
        <p data-template-id="stat-total-label" class="canva-text text-sm mb-2" style="color: rgb(113, 129, 124); font-weight: 500; font-style: normal; font-size: 15px;">Total assignments</p>
        <p id="totalTasks" class="brand-serif text-4xl text-[#17322d]">0</p>
       </div>
       <div class="w-11 h-11 rounded-2xl bg-[#e5efe4] flex items-center justify-center text-[#557563]"><i data-lucide="clipboard-list" class="w-5 h-5"></i>
       </div>
      </div>
     </article>
     <article data-template-id="stat-card-progress" class="canva-card rounded-[24px] p-5 border border-[#dde7df] card-shadow" style="background: rgb(255, 253, 248);">
      <div class="flex items-start justify-between">
       <div>
        <p data-template-id="stat-progress-label" class="canva-text text-sm mb-2" style="color: rgb(113, 129, 124); font-weight: 500; font-style: normal; font-size: 15px;">In progress</p>
        <p id="progressTasks" class="brand-serif text-4xl text-[#17322d]">0</p>
