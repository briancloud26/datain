<!doctype html>
<html lang="en"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Employee Work Tracker</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <script src="/_sdk/data_sdk.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&amp;family=Fraunces:wght@600;700&amp;display=swap" rel="stylesheet">
  <style>
    :root{
      --ink:#17322d;
      --muted:#71817c;
      --line:#dce5df;
      --cream:#f5f2ea;
      --panel:#fffdf8;
      --sage:#dfeadf;
      --sage-deep:#6e927c;
      --amber:#d89b4a;
      --danger:#bb5d54;
    }
    *{box-sizing:border-box}
    body{font-family:'DM Sans',sans-serif;color:var(--ink);margin:0}
    .brand-serif{font-family:'Fraunces',serif}
    .app-shell{width:100%;min-height:calc(100 * min(var(--vh, 1vh), 1vh));}
    .soft-grid{
      background-image:
        linear-gradient(rgba(23,50,45,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(23,50,45,.04) 1px, transparent 1px);
      background-size:32px 32px;
    }
    .card-shadow{box-shadow:0 12px 30px rgba(25,53,47,.08)}
    .drawer-backdrop{background:rgba(20,35,31,.28);backdrop-filter:blur(2px)}
    .drawer-panel{transform:translateX(100%);transition:transform .28s ease}
    .drawer-open .drawer-panel{transform:translateX(0)}
    .drawer-open{pointer-events:auto}
    .task-card{transition:transform .18s ease, box-shadow .18s ease}
    .task-card:hover{transform:translateY(-2px);box-shadow:0 18px 36px rgba(25,53,47,.10)}
    .focus-ring:focus{outline:3px solid rgba(110,146,124,.35);outline-offset:2px}
    .spinner{
      width:16px;height:16px;border:2px solid rgba(255,255,255,.45);border-top-color:#fff;
      border-radius:999px;animation:spin .8s linear infinite
    }
    @keyframes spin{to{transform:rotate(360deg)}}
    @media (max-width: 900px){
      .dashboard-grid{grid-template-columns:1fr !important}
      .side-panel{order:-1}
    }
  </style>
  <script src="/_sdk/resizing_sdk.js" type="text/javascript"></script>
 <script src="/_sdk/telemetry_sdk.js"></script></head>
 <body data-template-id="__page-root" style="background: rgb(245, 242, 234);">
  <div class="app-shell soft-grid">
   <header class="w-full border-b border-[#dfe7e1] bg-[#fbfaf6]/90 backdrop-blur">
