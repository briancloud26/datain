      </div>
      <div class="flex items-center md:justify-end gap-1 text-xs text-[#7f9189] mb-3"><i data-lucide="calendar" class="w-3.5 h-3.5"></i> <span class="due-date"></span>
      </div>
      <div class="flex gap-2 md:justify-end"><button class="edit-btn focus-ring w-9 h-9 rounded-full border border-[#dce6df] flex items-center justify-center text-[#637970]" type="button" aria-label="Edit task"> <i data-lucide="pencil" class="w-4 h-4"></i> </button> <button class="delete-btn focus-ring w-9 h-9 rounded-full border border-[#ead9d7] flex items-center justify-center text-[#b15f57]" type="button" aria-label="Delete task"> <i data-lucide="trash-2" class="w-4 h-4"></i> </button>
      </div>
