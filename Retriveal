    <div class="confirm-row hidden mt-4 pt-4 border-t border-[#edf1ed] flex items-center justify-between gap-3">
     <p data-template-id="delete-confirm-text" class="canva-text text-sm"></p>
     <div class="flex gap-2"><button class="confirm-delete rounded-full bg-[#bb5d54] text-white px-3 py-1.5 text-xs font-semibold" type="button">Delete</button> <button class="cancel-delete rounded-full bg-[#eef2ef] text-[#50665c] px-3 py-1.5 text-xs font-semibold" type="button">Cancel</button>
     </div>
    </div>
