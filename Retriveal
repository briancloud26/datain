  <template id="taskTemplate">
   <article data-template-id="task-card" class="canva-card task-card rounded-[24px] border border-[#dfe8e1] bg-white p-5 card-shadow" data-id="">
    <div class="flex flex-col md:flex-row md:items-start gap-4">
     <div class="flex items-start gap-4 flex-1">
      <div class="avatar w-12 h-12 shrink-0 rounded-2xl bg-[#e6efe7] text-[#496b58] flex items-center justify-center font-semibold"></div>
      <div class="min-w-0 flex-1">
       <div class="flex flex-wrap items-center gap-2 mb-1">
        <h3 class="employee-name brand-serif text-xl text-[#17322d]"></h3><span class="department-pill rounded-full bg-[#eef3ee] px-3 py-1 text-xs font-medium text-[#6c8177]"></span>
