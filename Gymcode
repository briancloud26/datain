<!doctype html>
<html lang="en"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gym Call Center</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&amp;display=swap" rel="stylesheet">
  <style>
        body { font-family: 'DM Sans', sans-serif; }
        .tab-active { border-bottom: 3px solid #e11d48; color: #e11d48; }
    </style>
  <script src="/_sdk/resizing_sdk.js" type="text/javascript"></script>
 </head>
 <body data-template-id="__page-root" class="w-full min-h-screen" style="background: rgb(15, 15, 15);">
  <header class="w-full bg-black/90 backdrop-blur sticky top-0 z-50">
   <nav class="max-w-7xl mx-auto flex items-center justify-between px-6 py-4">
    <h1 data-template-id="brand-name" class="canva-text text-2xl font-bold" style="color: rgb(225, 29, 72); font-weight: bold; font-style: normal; font-size: 24px;">IRONFORGE GYM</h1>
    <div class="flex gap-1"><button id="tab-info" class="px-4 py-2 text-sm font-medium text-white tab-active" onclick="showTab('info')">Gym Info</button> <button id="tab-agent" class="px-4 py-2 text-sm font-medium text-gray-400" onclick="showTab('agent')">Call Agent</button>
    </div>
   </nav>
  </header><!-- GYM INFO -->
  <main id="view-info" class="w-full">
   <section class="relative w-full h-[500px] overflow-hidden"><img data-template-id="hero-image" class="canva-image w-full h-full object-cover" loading="lazy" src="https://images.pexels.com/photos/29392546/pexels-photo-29392546.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1280" alt="Dark, atmospheric gym with mirrored weightlifting machines and neon lighting.">
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex items-end p-8 md:p-16">
     <div>
      <h2 data-template-id="hero-title" class="canva-text text-white" style="color: rgb(255, 255, 255); font-weight: bold; font-style: normal; font-size: 42px;">Forge Your Strongest Self</h2>
      <p data-template-id="hero-subtitle" class="canva-text text-gray-200 mt-2 max-w-xl" style="color: rgb(209, 213, 219); font-weight: 400; font-style: normal; font-size: 18px;">State-of-the-art equipment, expert trainers, and a community that pushes you beyond limits.</p>
     </div>
    </div>
   </section>
   <section class="max-w-7xl mx-auto px-6 py-16 grid md:grid-cols-2 gap-12 items-center"><img data-template-id="classes-image" class="canva-image w-full h-72 object-cover rounded-2xl" loading="lazy" src="https://images.pexels.com/photos/868483/pexels-photo-868483.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800" alt="Three women engage in a yoga session on pink mats in a bright, open gym setting.">
    <div>
     <h3 data-template-id="classes-title" class="canva-text font-bold" style="color: rgb(255, 255, 255); font-weight: bold; font-style: normal; font-size: 28px;">Group Classes</h3>
     <p data-template-id="classes-desc" class="canva-text mt-3 leading-relaxed" style="color: rgb(156, 163, 175); font-weight: 400; font-style: normal; font-size: 16px;">From high-intensity interval training to calming yoga flows, our 30+ weekly classes cater to every fitness level. Led by certified instructors in purpose-built studios.</p>
    </div>
   </section>
   <section data-template-id="trainer-section" class="canva-section w-full py-16" style="background: rgb(26, 26, 26);">
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
     <div>
      <h3 data-template-id="trainer-title" class="canva-text font-bold" style="color: rgb(255, 255, 255); font-weight: bold; font-style: normal; font-size: 28px;">Personal Training</h3>
      <p data-template-id="trainer-desc" class="canva-text mt-3 leading-relaxed" style="color: rgb(156, 163, 175); font-weight: 400; font-style: normal; font-size: 16px;">Our certified personal trainers design custom programs around your goals. Whether you're training for competition or starting fresh, get one-on-one guidance that delivers results.</p>
     </div><img data-template-id="trainer-image" class="canva-image w-full h-72 object-cover rounded-2xl" loading="lazy" src="https://images.pexels.com/photos/6456300/pexels-photo-6456300.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800" alt="Personal trainer helping client during intense workout in gym">
    </div>
   </section>
   <section class="max-w-7xl mx-auto px-6 py-16">
    <h3 data-template-id="pricing-title" class="canva-text font-bold text-center mb-10" style="color: rgb(255, 255, 255); font-weight: bold; font-style: normal; font-size: 28px;">Membership Plans</h3>
    <div class="grid md:grid-cols-3 gap-6">
     <div data-template-id="plan-1" class="canva-card rounded-2xl p-8 text-center" style="background: rgb(31, 31, 31);">
      <h4 data-template-id="plan-1-name" class="canva-text font-bold" style="color: rgb(255, 255, 255); font-weight: bold; font-style: normal; font-size: 20px;">Basic</h4>
      <p data-template-id="plan-1-price" class="canva-text text-3xl font-bold mt-4" style="color: rgb(225, 29, 72); font-weight: bold; font-style: normal; font-size: 16px;">$29/mo</p>
      <p data-template-id="plan-1-desc" class="canva-text mt-3" style="color: rgb(156, 163, 175); font-weight: 400; font-style: normal; font-size: 16px;">Gym floor access, locker rooms, free WiFi</p>
     </div>
     <div data-template-id="plan-2" class="canva-card rounded-2xl p-8 text-center border-2 border-rose-500" style="background: rgb(31, 31, 31);">
      <h4 data-template-id="plan-2-name" class="canva-text font-bold" style="color: rgb(255, 255, 255); font-weight: bold; font-style: normal; font-size: 20px;">Pro</h4>
      <p data-template-id="plan-2-price" class="canva-text text-3xl font-bold mt-4" style="color: rgb(225, 29, 72); font-weight: bold; font-style: normal; font-size: 16px;">$59/mo</p>
      <p data-template-id="plan-2-desc" class="canva-text mt-3" style="color: rgb(156, 163, 175); font-weight: 400; font-style: normal; font-size: 16px;">All classes, sauna, nutrition guide</p>
     </div>
     <div data-template-id="plan-3" class="canva-card rounded-2xl p-8 text-center" style="background: rgb(31, 31, 31);">
      <h4 data-template-id="plan-3-name" class="canva-text font-bold" style="color: rgb(255, 255, 255); font-weight: bold; font-style: normal; font-size: 20px;">Elite</h4>
      <p data-template-id="plan-3-price" class="canva-text text-3xl font-bold mt-4" style="color: rgb(225, 29, 72); font-weight: bold; font-style: normal; font-size: 16px;">$99/mo</p>
      <p data-template-id="plan-3-desc" class="canva-text mt-3" style="color: rgb(156, 163, 175); font-weight: 400; font-style: normal; font-size: 16px;">Personal trainer, recovery suite, guest passes</p>
     </div>
    </div>
   </section>
  </main><!-- CALL AGENT -->
  <main id="view-agent" class="w-full hidden">
   <div class="max-w-7xl mx-auto px-6 py-10">
    <h2 data-template-id="agent-title" class="canva-text font-bold mb-6" style="color: rgb(255, 255, 255); font-weight: bold; font-style: normal; font-size: 28px;">Call Agent Dashboard</h2>
    <form id="call-form" class="bg-gray-900 rounded-2xl p-6 mb-10 grid md:grid-cols-2 gap-4">
     <div><label data-template-id="label-name" for="cust-name" class="canva-text block mb-1 text-sm font-medium" style="color: rgb(209, 213, 219); font-weight: 500; font-style: normal; font-size: 16px;">Customer Name</label> <input id="cust-name" type="text" required="" class="w-full rounded-lg bg-gray-800 border border-gray-700 text-white px-3 py-2">
     </div>
     <div><label data-template-id="label-phone" for="cust-phone" class="canva-text block mb-1 text-sm font-medium" style="color: rgb(209, 213, 219); font-weight: 500; font-style: normal; font-size: 16px;">Phone Number</label> <input id="cust-phone" type="tel" required="" class="w-full rounded-lg bg-gray-800 border border-gray-700 text-white px-3 py-2">
     </div>
     <div><label data-template-id="label-interest" for="cust-interest" class="canva-text block mb-1 text-sm font-medium" style="color: rgb(209, 213, 219); font-weight: 500; font-style: normal; font-size: 16px;">Membership Interest</label> <select id="cust-interest" class="w-full rounded-lg bg-gray-800 border border-gray-700 text-white px-3 py-2"> <option value="Basic">Basic</option> <option value="Pro">Pro</option> <option value="Elite">Elite</option> <option value="Unsure">Unsure</option> </select>
     </div>
     <div><label data-template-id="label-status" for="cust-status" class="canva-text block mb-1 text-sm font-medium" style="color: rgb(209, 213, 219); font-weight: 500; font-style: normal; font-size: 16px;">Call Status</label> <select id="cust-status" class="w-full rounded-lg bg-gray-800 border border-gray-700 text-white px-3 py-2"> <option value="completed">Completed</option> <option value="follow-up">Follow-up</option> <option value="pending">Pending</option> </select>
     </div>
     <div class="md:col-span-2"><label data-template-id="label-notes" for="cust-notes" class="canva-text block mb-1 text-sm font-medium" style="color: rgb(209, 213, 219); font-weight: 500; font-style: normal; font-size: 16px;">Notes</label> <textarea id="cust-notes" rows="2" class="w-full rounded-lg bg-gray-800 border border-gray-700 text-white px-3 py-2"></textarea>
     </div>
     <div class="md:col-span-2"><button data-template-id="submit-btn" type="submit" class="canva-button px-6 py-2 rounded-lg font-medium" style="background: rgb(225, 29, 72); color: rgb(255, 255, 255); font-weight: 600; font-style: normal; font-size: 16px;">Log Call</button>
     </div>
    </form>
    <div id="call-log" class="space-y-3"></div>
    <p id="empty-log" data-template-id="empty-log" class="canva-text text-center py-8" style="color: rgb(107, 114, 128); font-weight: 400; font-style: italic; font-size: 16px;">No calls logged yet. Use the form above to record customer outreach.</p>
    <p id="limit-warning" class="hidden text-red-400 text-center py-4 font-medium">Maximum 999 records reached. Please delete some entries.</p>
   </div>
  </main>
  <template id="call-card-template">
   <div data-template-id="call-card" class="canva-card rounded-xl p-4 flex flex-col md:flex-row md:items-center justify-between gap-2">
    <div class="flex-1">
     <p data-template-id="call-card-name" class="canva-text font-semibold"></p>
     <p data-template-id="call-card-details" class="canva-text text-sm mt-1"></p>
    </div>
    <div class="flex items-center gap-3"><span data-template-id="call-card-status" class="canva-tag px-2 py-1 rounded text-xs font-medium"></span> <button class="delete-btn text-gray-400 hover:text-red-400" title="Delete"><i data-lucide="trash-2" style="width:16px;height:16px;"></i></button>
    </div>
   </div>
  </template>
  <script src="/_sdk/editing_sdk.js"></script>
  <script src="/_sdk/data_sdk.js"></script>
  <script>
        let allRecords = [];

        function showTab(tab) {
            document.getElementById('view-info').classList.toggle('hidden', tab !== 'info');
            document.getElementById('view-agent').classList.toggle('hidden', tab !== 'agent');
            document.getElementById('tab-info').classList.toggle('tab-active', tab === 'info');
            document.getElementById('tab-info').classList.toggle('text-gray-400', tab !== 'info');
            document.getElementById('tab-agent').classList.toggle('tab-active', tab === 'agent');
            document.getElementById('tab-agent').classList.toggle('text-gray-400', tab !== 'agent');
        }

        function renderLog(data) {
            const container = document.getElementById('call-log');
            const empty = document.getElementById('empty-log');
            empty.classList.toggle('hidden', data.length > 0);

            const existingMap = new Map([...container.children].map(el => [el.dataset.id, el]));
            const newIds = new Set(data.map(r => r.__backendId));

            existingMap.forEach((el, id) => { if (!newIds.has(id)) el.remove(); });

            data.forEach(record => {
                if (existingMap.has(record.__backendId)) {
                    const el = existingMap.get(record.__backendId);
                    el.querySelector('[data-template-id="call-card-name"]').textContent = record.customer_name + ' — ' + record.phone_number;
                    el.querySelector('[data-template-id="call-card-details"]').textContent = record.membership_interest + ' | ' + (record.notes || '—') + ' | ' + new Date(record.call_date).toLocaleDateString();
                    el.querySelector('[data-template-id="call-card-status"]').textContent = record.call_status;
                } else {
                    const tpl = document.getElementById('call-card-template');
                    const clone = tpl.content.cloneNode(true);
                    const card = clone.firstElementChild;
                    card.dataset.id = record.__backendId;
                    card.querySelector('[data-template-id="call-card-name"]').textContent = record.customer_name + ' — ' + record.phone_number;
                    card.querySelector('[data-template-id="call-card-details"]').textContent = record.membership_interest + ' | ' + (record.notes || '—') + ' | ' + new Date(record.call_date).toLocaleDateString();
                    card.querySelector('[data-template-id="call-card-status"]').textContent = record.call_status;
                    card.querySelector('.delete-btn').addEventListener('click', () => deleteRecord(record));
                    container.appendChild(card);
                    lucide.createIcons();
                }
            });
        }

        async function deleteRecord(record) {
            const result = await window.dataSdk.delete(record);
            if (!result.isOk) { /* silently fail */ }
        }

        const handler = {
            onDataChanged(data) {
                allRecords = data;
                renderLog(data);
            }
        };

        document.getElementById('call-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            if (allRecords.length >= 999) {
                document.getElementById('limit-warning').classList.remove('hidden');
                return;
            }
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true; btn.textContent = 'Saving...';

            const result = await window.dataSdk.create({
                customer_name: document.getElementById('cust-name').value,
                phone_number: document.getElementById('cust-phone').value,
                membership_interest: document.getElementById('cust-interest').value,
                call_status: document.getElementById('cust-status').value,
                notes: document.getElementById('cust-notes').value,
                call_date: new Date().toISOString()
            });

            btn.disabled = false; btn.textContent = 'Log Call';
            if (result.isOk) e.target.reset();
        });

        (async () => {
            await window.dataSdk.init(handler);
            lucide.createIcons();
        })();
    </script>
