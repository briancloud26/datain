  <script>
    document.addEventListener("DOMContentLoaded", () => {
      lucide.createIcons();

      const root = document.documentElement;
      const demo = document.getElementById("demo-frame");
      const status = document.getElementById("status-message");
      const sourceLabel = document.getElementById("demo-source-label");
      const comparisonPreview = document.getElementById("comparison-preview");
      const differenceButton = document.getElementById("difference-button");
      const differenceStatus = document.getElementById("difference-status");
      const differenceStates = ["Subtle", "Balanced", "Strong"];
      let differenceIndex = 1;
      function updateDifference() {
        const state = differenceStates[differenceIndex];
        comparisonPreview.classList.remove("is-subtle", "is-balanced", "is-strong");
        comparisonPreview.classList.add("is-" + state.toLowerCase());
        differenceStatus.textContent = state;
        differenceButton.setAttribute("aria-label", "Adjust difference: " + state + ". Click to cycle.");
      }
      differenceButton.addEventListener("click", () => {
        differenceIndex = (differenceIndex + 1) % differenceStates.length;
        updateDifference();
      });
      const controls = {
        palette: document.getElementById("palette-select"),
        type: document.getElementById("type-select"),
        radius: document.getElementById("radius-range"),
        spacing: document.getElementById("spacing-range"),
        shadow: document.getElementById("shadow-select"),
        motion: document.getElementById("motion-select")
      };

      const palettes = {
        violet: { accent: "#6757e8", accent2: "#45a5f6", bg: "#f7f7ff", text: "#1d1a3b", muted: "#625f78" },
        ocean: { accent: "#097b8c", accent2: "#3bb9d4", bg: "#f2fbfc", text: "#10313a", muted: "#507079" },
        sunset: { accent: "#db5b58", accent2: "#f1a852", bg: "#fff9f4", text: "#3a1f2c", muted: "#80606b" },
        mono: { accent: "#232334", accent2: "#77788d", bg: "#fbfbfc", text: "#17171e", muted: "#676776" }
      };

      const presetValues = {
        modern: { palette: "violet", type: "sans", radius: 18, spacing: 22, shadow: "soft", motion: "gentle" },
        editorial: { palette: "mono", type: "editorial", radius: 4, spacing: 30, shadow: "crisp", motion: "calm" },
        playful: { palette: "sunset", type: "sans", radius: 28, spacing: 18, shadow: "bold", motion: "lively" },
        luxury: { palette: "ocean", type: "editorial", radius: 10, spacing: 26, shadow: "soft", motion: "gentle" }
      };

      function applyPalette() {
        const palette = palettes[controls.palette.value];
        root.style.setProperty("--preview-accent", palette.accent);
        root.style.setProperty("--preview-accent-2", palette.accent2);
        root.style.setProperty("--preview-bg", palette.bg);
        root.style.setProperty("--preview-text", palette.text);
        root.style.setProperty("--preview-muted", palette.muted);
      }

      function applyType() {
        const families = {
          sans: '"DM Sans", sans-serif',
          editorial: '"Fraunces", serif',
          mono: '"Space Mono", monospace'
        };
        root.style.setProperty("--preview-font", families[controls.type.value]);
      }

      function applyRadius() {
        const value = controls.radius.value;
        root.style.setProperty("--preview-radius", value + "px");
        document.getElementById("radius-value").textContent = value + " px";
      }

      function applySpacing() {
        const value = controls.spacing.value;
        root.style.setProperty("--preview-gap", value + "px");
        document.getElementById("spacing-value").textContent = value + " px";
      }

      function applyShadow() {
        const shadows = {
          soft: "0 18px 36px rgba(35, 27, 96, .16)",
          crisp: "8px 8px 0 rgba(35, 27, 96, .18)",
          bold: "0 26px 55px rgba(35, 27, 96, .30)"
        };
        root.style.setProperty("--preview-shadow", shadows[controls.shadow.value]);
      }

      function applyMotion() {
        demo.classList.remove("demo-pulse", "demo-breathe");
        if (controls.motion.value === "gentle") demo.classList.add("demo-breathe");
        if (controls.motion.value === "lively") {
          demo.classList.add("demo-breathe", "demo-pulse");
          root.style.setProperty("--motion", ".28s");
        } else {
          root.style.setProperty("--motion", controls.motion.value === "calm" ? ".7s" : ".45s");
        }
      }

      function updatePreview() {
        applyPalette();
        applyType();
        applyRadius();
        applySpacing();
        applyShadow();
        applyMotion();
      }

      Object.values(controls).forEach(control => {
        control.addEventListener("input", updatePreview);
        control.addEventListener("change", updatePreview);
      });

      document.querySelectorAll("[data-preset]").forEach(button => {
        button.addEventListener("click", () => {
          const preset = presetValues[button.dataset.preset];
          controls.palette.value = preset.palette;
          controls.type.value = preset.type;
          controls.radius.value = preset.radius;
          controls.spacing.value = preset.spacing;
          controls.shadow.value = preset.shadow;
          controls.motion.value = preset.motion;
          updatePreview();

          document.querySelectorAll("[data-preset]").forEach(item => item.classList.remove("is-active"));
          button.classList.add("is-active");
          status.textContent = button.textContent.trim() + " styling applied to the local demo.";
        });
      });

      document.getElementById("source-form").addEventListener("submit", event => {
        event.preventDefault();
        const url = document.getElementById("website-url").value.trim();
        const snippet = document.getElementById("html-snippet").value.trim();

        if (!url && !snippet) {
          status.textContent = "Add a website URL or a short HTML snippet to personalize this local demo.";
          return;
        }

        if (url && !/^https?:\/\/.+/i.test(url)) {
          status.textContent = "Please enter a complete URL beginning with https:// or use an HTML snippet.";
          return;
        }

        sourceLabel.textContent = url
          ? "Local styling direction for " + url.replace(/^https?:\/\//i, "").replace(/\/$/, "") + "."
          : "Local styling direction based on your HTML snippet.";
        status.textContent = "Your local preview is ready to explore — no external site was accessed.";
      });

      document.getElementById("start-button").addEventListener("click", () => {
        document.getElementById("workspace").scrollIntoView({ behavior: "smooth", block: "start" });
      });

      updatePreview();
      updateDifference();
    });
  </script>
 
