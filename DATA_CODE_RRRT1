    .control-shell:focus-within {
      border-color: #6757e8;
      transform: translateY(-1px);
    }

    .preset-button {
      border: 1px solid #dedcf0;
      background: #fff;
      color: #403d58;
      transition: all .22s ease;
    }

    .preset-button:hover { border-color: #958bf0; transform: translateY(-2px); }
