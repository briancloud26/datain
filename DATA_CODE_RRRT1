      background-size: 38px 38px;
    }

    .hero-glow {
      position: absolute;
      width: 38rem;
      height: 38rem;
      border-radius: 999px;
      filter: blur(25px);
      background: radial-gradient(circle, rgba(89, 112, 255, .48), rgba(103, 87, 232, 0) 68%);
