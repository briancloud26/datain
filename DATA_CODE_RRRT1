      inset: 0;
      background: linear-gradient(135deg, rgba(103,87,232,.35), transparent 58%);
      pointer-events: none;
    }

    .float-card {
      box-shadow: 0 16px 42px rgba(7, 5, 31, .34);
      animation: float 4.5s ease-in-out infinite;
    }

    .section-reveal {
      animation: rise .7s ease both;
