      background: linear-gradient(135deg, #6757e8, #457ff6);
      box-shadow: 0 10px 20px rgba(103, 87, 232, .20);
    }

    .range-input { accent-color: #6757e8; }

    .demo-frame {
      background: var(--preview-bg);
      border-radius: var(--preview-radius);
      box-shadow: var(--preview-shadow);
      font-family: var(--preview-font);
      gap: var(--preview-gap);
      transition: border-radius var(--motion) ease, box-shadow var(--motion) ease, background var(--motion) ease, color var(--motion) ease;
    }

    .demo-nav, .demo-chip, .demo-cta, .demo-feature {
      transition: all var(--motion) ease;
    }

    .demo-cta {
      border-radius: calc(var(--preview-radius) * .62);
      background: var(--preview-accent);
      color: #ffffff;
    }

    .demo-chip {
      background: color-mix(in srgb, var(--preview-accent) 12%, white);
      color: var(--preview-accent);
    }

    .demo-visual {
      border-radius: calc(var(--preview-radius) * .88);
      background: linear-gradient(145deg, var(--preview-accent), var(--preview-accent-2));
    }

    .demo-feature {
      border-radius: calc(var(--preview-radius) * .72);
      background: rgba(255,255,255,.78);
      border: 1px solid color-mix(in srgb, var(--preview-accent) 16%, white);
    }

    .demo-pulse .demo-cta { animation: gentlePulse 1.9s ease-in-out infinite; }
    .demo-breathe .demo-visual { animation: breathe 2.7s ease-in-out infinite; }

    .comparison-before { filter: saturate(.45); }
    .comparison-preview { --difference-opacity: 1; --difference-saturation: 1; --difference-spacing: 1; --difference-shadow: 1; --difference-type-scale: 1; }
    .comparison-preview .comparison-before { filter: saturate(calc(.45 + (1 - var(--difference-saturation)) * .25)); }
    .comparison-preview article:last-child { filter: saturate(var(--difference-saturation)); box-shadow: 0 18px 28px rgba(103, 87, 232, calc(.18 * var(--difference-shadow))); }
    .comparison-preview article:last-child > div { padding: calc(1rem * var(--difference-spacing)); }
    .comparison-preview article:last-child > div > div { transform: scale(var(--difference-type-scale)); transform-origin: top left; }
    .comparison-preview.is-subtle { --difference-saturation: .92; --difference-spacing: 1.02; --difference-shadow: .45; --difference-type-scale: 1.01; }
    .comparison-preview.is-balanced { --difference-saturation: 1.08; --difference-spacing: 1.12; --difference-shadow: .8; --difference-type-scale: 1.04; }
    .comparison-preview.is-strong { --difference-saturation: 1.24; --difference-spacing: 1.25; --difference-shadow: 1.25; --difference-type-scale: 1.08; }
    .check-item::before {
      content: "✓";
      display: grid;
      place-items: center;
      width: 1.45rem;
      height: 1.45rem;
      border-radius: 999px;
      flex: 0 0 auto;
      color: #ffffff;
      background: #6757e8;
      font-size: .78rem;
      font-weight: 700;
    }

    @keyframes rise {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
    @keyframes gentlePulse {
      50% { transform: translateY(-2px) scale(1.025); box-shadow: 0 13px 24px color-mix(in srgb, var(--preview-accent) 35%, transparent); }
    }
    @keyframes breathe {
