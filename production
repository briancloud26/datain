<!doctype html>
<html lang="en"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manufacturing SQL Query Reference</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&amp;family=Space+Mono&amp;display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.263.0/dist/umd/lucide.min.js"></script>
  <style>
        body { font-family: 'DM Sans', sans-serif; }
        code, .code-block { font-family: 'Space Mono', monospace; }
        .query-card .code-block { display: none; }
        .query-card.open .code-block { display: block; }
        .query-card .chevron { transition: transform 0.2s; }
        .query-card.open .chevron { transform: rotate(180deg); }
    </style>
  <script src="/_sdk/data_sdk.js" type="text/javascript"></script>
  <script src="/_sdk/resizing_sdk.js" type="text/javascript"></script>
 </head>
 <body data-template-id="__page-root" class="w-full min-h-screen" style="background: rgb(15, 23, 42);">
  <header class="relative h-72 overflow-hidden flex items-center justify-center"><img data-template-id="hero-image" loading="lazy" class="canva-image absolute inset-0 w-full h-full object-cover" src="https://images.pexels.com/photos/34718930/pexels-photo-34718930.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1280" alt="Wide view of a modern factory interior showcasing industrial machinery and conveyor systems.">
   <div class="absolute inset-0 bg-black/60"></div>
   <div class="relative text-center px-4">
    <h1 data-template-id="hero-title" class="canva-text text-4xl font-bold" style="color: rgb(255, 255, 255); font-weight: bold; font-style: normal; font-size: 32px;">Manufacturing SQL Query Reference</h1>
    <p data-template-id="hero-subtitle" class="canva-text mt-3 text-lg max-w-2xl mx-auto" style="color: rgb(203, 213, 225); font-weight: 400; font-style: normal; font-size: 16px;">Essential SQL queries for inventory tracking, production management, and quality control in manufacturing databases.</p>
   </div>
  </header>
  <main class="max-w-5xl mx-auto px-4 py-12 space-y-12"><!-- Schema Section -->
   <section>
    <h2 data-template-id="schema-heading" class="canva-text text-2xl font-bold mb-4" style="color: rgb(241, 245, 249); font-weight: bold; font-style: normal; font-size: 24px;">Database Schema</h2>
    <div data-template-id="schema-box" class="canva-card rounded-lg p-5 overflow-x-auto" style="background: rgb(30, 41, 59);">
     <pre class="code-block text-sm leading-relaxed" style="display:block"><code>-- Core Manufacturing Tables
CREATE TABLE products (product_id INT PRIMARY KEY, name VARCHAR(100), sku VARCHAR(50), unit_cost DECIMAL(10,2));
CREATE TABLE inventory (inventory_id INT PRIMARY KEY, product_id INT, warehouse VARCHAR(50), qty INT);
CREATE TABLE work_orders (wo_id INT PRIMARY KEY, product_id INT, qty INT, status VARCHAR(20), start_date DATE);
CREATE TABLE quality_checks (qc_id INT PRIMARY KEY, wo_id INT, pass BOOLEAN, inspector VARCHAR(50), check_date DATE);</code></pre>
    </div>
   </section><!-- Inventory Queries -->
   <section>
    <h2 data-template-id="section-inventory" class="canva-text text-2xl font-bold mb-4" style="color: rgb(52, 211, 153); font-weight: bold; font-style: normal; font-size: 24px;">Inventory Queries</h2>
    <div class="space-y-3">
     <div class="query-card"><button class="query-toggle w-full flex items-center justify-between p-4 rounded-lg bg-slate-800 text-white" type="button"> <span data-template-id="q1-title" class="canva-text font-medium" style="color: rgb(255, 255, 255); font-weight: 500; font-style: normal; font-size: 16px;">Find Low-Stock Items (Below 50 Units)</span> <i data-lucide="chevron-down" class="chevron w-5 h-5"></i> </button>
      <div class="code-block bg-slate-900 text-emerald-300 p-4 rounded-b-lg text-sm">
       <pre>SELECT p.name, i.warehouse, i.qty
FROM inventory i
JOIN products p ON p.product_id = i.product_id
WHERE i.qty &lt; 50
ORDER BY i.qty ASC;</pre>
      </div>
     </div>
     <div class="query-card"><button class="query-toggle w-full flex items-center justify-between p-4 rounded-lg bg-slate-800 text-white" type="button"> <span data-template-id="q2-title" class="canva-text font-medium" style="color: rgb(255, 255, 255); font-weight: 500; font-style: normal; font-size: 16px;">Warehouse Inventory Summary</span> <i data-lucide="chevron-down" class="chevron w-5 h-5"></i> </button>
      <div class="code-block bg-slate-900 text-emerald-300 p-4 rounded-b-lg text-sm">
       <pre>SELECT warehouse, SUM(qty) AS total_units,
       COUNT(DISTINCT product_id) AS unique_products
FROM inventory
GROUP BY warehouse;</pre>
      </div>
     </div>
    </div>
   </section><!-- Production Queries -->
   <section>
    <h2 data-template-id="section-production" class="canva-text text-2xl font-bold mb-4" style="color: rgb(96, 165, 250); font-weight: bold; font-style: normal; font-size: 24px;">Production Queries</h2>
    <div class="space-y-3">
     <div class="query-card"><button class="query-toggle w-full flex items-center justify-between p-4 rounded-lg bg-slate-800 text-white" type="button"> <span data-template-id="q3-title" class="canva-text font-medium" style="color: rgb(255, 255, 255); font-weight: 500; font-style: normal; font-size: 16px;">Active Work Orders</span> <i data-lucide="chevron-down" class="chevron w-5 h-5"></i> </button>
      <div class="code-block bg-slate-900 text-emerald-300 p-4 rounded-b-lg text-sm">
       <pre>SELECT wo.wo_id, p.name, wo.qty, wo.status, wo.start_date
FROM work_orders wo
JOIN products p ON p.product_id = wo.product_id
WHERE wo.status = 'In Progress'
ORDER BY wo.start_date;</pre>
      </div>
     </div>
     <div class="query-card"><button class="query-toggle w-full flex items-center justify-between p-4 rounded-lg bg-slate-800 text-white" type="button"> <span data-template-id="q4-title" class="canva-text font-medium" style="color: rgb(255, 255, 255); font-weight: 500; font-style: normal; font-size: 16px;">Top Products Produced (Last 30 Days)</span> <i data-lucide="chevron-down" class="chevron w-5 h-5"></i> </button>
      <div class="code-block bg-slate-900 text-emerald-300 p-4 rounded-b-lg text-sm">
       <pre>SELECT p.name, SUM(wo.qty) AS total_produced
FROM work_orders wo
JOIN products p ON p.product_id = wo.product_id
WHERE wo.status = 'Completed'
  AND wo.start_date &gt;= DATE_SUB(CURDATE(), INTERVAL 30 DAY)
GROUP BY p.name
ORDER BY total_produced DESC;</pre>
      </div>
     </div>
    </div>
   </section><!-- Quality Control Queries -->
   <section>
    <h2 data-template-id="section-quality" class="canva-text text-2xl font-bold mb-4" style="color: rgb(251, 191, 36); font-weight: bold; font-style: normal; font-size: 24px;">Quality Control Queries</h2>
    <div class="space-y-3">
     <div class="query-card"><button class="query-toggle w-full flex items-center justify-between p-4 rounded-lg bg-slate-800 text-white" type="button"> <span data-template-id="q5-title" class="canva-text font-medium" style="color: rgb(255, 255, 255); font-weight: 500; font-style: normal; font-size: 16px;">Product Pass Rate Report</span> <i data-lucide="chevron-down" class="chevron w-5 h-5"></i> </button>
      <div class="code-block bg-slate-900 text-emerald-300 p-4 rounded-b-lg text-sm">
       <pre>SELECT p.name,
       COUNT(*) AS total_checks,
       SUM(CASE WHEN qc.pass THEN 1 ELSE 0 END) AS passed,
       ROUND(AVG(qc.pass) * 100, 1) AS pass_rate
FROM quality_checks qc
JOIN work_orders wo ON wo.wo_id = qc.wo_id
JOIN products p ON p.product_id = wo.product_id
GROUP BY p.name;</pre>
      </div>
     </div>
    </div>
   </section>
  </main>
  <footer class="text-center py-6">
   <p data-template-id="footer-text" class="canva-text text-sm" style="color: rgb(100, 116, 139); font-weight: 400; font-style: normal; font-size: 16px;">Manufacturing SQL Reference — Built for database administrators and production engineers.</p>
  </footer>
